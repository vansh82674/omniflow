{
  "name": "omniflow-sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for OmniFlow AI Document Extraction",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --minify",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "omniflow",
    "ai",
    "document",
    "extraction",
    "sdk"
  ],
  "author": "Vansh Pachori",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
